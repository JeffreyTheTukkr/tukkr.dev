{
    "name": "tukkr",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig tsconfig.json --watch",
        "lint": "prettier --check . '!pnpm-lock.yaml' && eslint .",
        "format": "prettier --write . '!pnpm-lock.yaml'",
        "prepare": "husky"
    },
    "dependencies": {
        "gray-matter": "^4.0.3",
        "mdsvex": "^0.12.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "sass": "^1.102.0",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.5",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1"
    },
    "lint-staged": {
        "*": [
            "prettier --write . '!pnpm-lock.yaml'"
        ]
    },
    "type": "module"
}
